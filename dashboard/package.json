{
  "name": "ray-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:federation": "FEDERATION_DEMO_CUSTOM_SERVER=1 next build",
    "test:federation": "tsx --test src/federation/*.test.ts",
    "test:federation:e2e": "playwright test --config demo/federation/playwright.config.ts",
    "start:federation": "FEDERATION_DEMO_CUSTOM_SERVER=1 node demo/federation/server.mjs",
    "start": "next start",
    "lint": "next lint --max-warnings 0 && prettier . --check && tsc --noEmit",
    "fix": "next lint --fix --max-warnings 0 && prettier . --write && tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/view": "6.43.12",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@kubernetes/client-node": "^1.3.0",
    "@mui/icons-material": "^5.15.14",
    "@mui/joy": "^5.0.0-beta.32",
    "@mui/material": "^5.15.14",
    "@uiw/react-codemirror": "4.25.11",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.11.6",
    "dayjs": "^1.11.10",
    "next": "15.5.18",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2.2.5",
    "ws": "8.18.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "8.18.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "postcss": "^8",
    "prettier": "3.6.2",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.9.2"
}
